# ─── 공공데이터 API ────────────────────────────────────────────────
# 공공데이터 포털 (data.go.kr) 에서 발급
WELFARE_API_KEY=your_api_key_here

# ─── 임베딩 모델 ───────────────────────────────────────────────────
# HuggingFace 한국어 모델 사용 (로컬, 무료 - API 키 불필요)
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ─── ChromaDB ─────────────────────────────────────────────────────
# 로컬 파일 저장 경로
CHROMA_PERSIST_DIR=./data/chroma

# ─── FastAPI 서버 ──────────────────────────────────────────────────
API_HOST=0.0.0.0
RAG_API_PORT=8002
