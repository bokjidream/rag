# ─── 임베딩 모델 ───────────────────────────────────────────────────
# HuggingFace 한국어 모델 사용 (로컬, 무료 - API 키 불필요)
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ─── ChromaDB ─────────────────────────────────────────────────────
# 로컬 파일 저장 경로 (기본값: ./data/chroma)
CHROMA_PERSIST_DIR=./data/chroma

# ─── FastAPI 서버 ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── 크롤링 대상 ───────────────────────────────────────────────────
# 복지로 기본 URL
BOKJIRO_BASE_URL=https://www.bokjiro.go.kr
