# ─── 공공데이터 API ────────────────────────────────────────────────
# 공공데이터 포털 (data.go.kr) 에서 발급
PUBLIC_DATA_API_KEY=your_api_key_here

# ─── 임베딩 모델 ───────────────────────────────────────────────────
# 모델명은 ADR-002 결정에 따라 src/embedding/kosimcse.py에 하드코딩 (jhgan/ko-sroberta-multitask)
# 변경 시 코드를 수정하라 — 환경변수로 오버라이드하면 RAG 결과 일관성 보장 불가

# ─── ChromaDB ─────────────────────────────────────────────────────
# 로컬 파일 저장 경로 (기본값: data/chroma)
CHROMA_PERSIST_DIR=data/chroma
# "persistent" (기본값, data/chroma 사용) | "ephemeral" (in-memory, 테스트용)
CHROMA_MODE=persistent

# ─── FastAPI 서버 ──────────────────────────────────────────────────
API_HOST=0.0.0.0
RAG_API_PORT=8002
